{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "HAQuDA: Build + Flash + Monitor",
			"detail": "Asks for the folder, then builds and flashes the lamp, with the serial monitor next to it. Run HAQuDA: Install picker once first.",
			"dependsOn": [
				"HAQuDA: Build + Flash",
				"HAQuDA: Monitor"
			],
			"dependsOrder": "parallel",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "HAQuDA: Build + Flash",
			"detail": "Builds the chosen folder and flashes the lamp. The monitor, if running, steps aside for the flash.",
			"type": "shell",
			"command": "py",
			"args": [
				"-3",
				"${workspaceFolder}\\Software\\Software_ver_2\\HAQuDA_Esp32\\scripts\\haquda-bench.py",
				"--action",
				"BuildFlash",
				"--source",
				"${input:source}"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"group": "haquda",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "HAQuDA: Monitor",
			"detail": "Serial monitor (esp-idf-monitor, needs py -3 -m pip install esp-idf-monitor). Releases the port while a flash runs. Quit with Ctrl+] or Ctrl+C in its terminal.",
			"type": "shell",
			"command": "py",
			"args": [
				"-3",
				"${workspaceFolder}\\Software\\Software_ver_2\\HAQuDA_Esp32\\scripts\\haquda-bench.py",
				"--action",
				"Monitor"
			],
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"group": "haquda",
				"clear": false
			},
			"problemMatcher": {
				"owner": "haquda-monitor",
				"pattern": {
					"regexp": "^haquda-monitor-never-matches (.*):(\\d+): (.*)$",
					"file": 1,
					"line": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^--- monitor starting",
					"endsPattern": "^--- monitor ready"
				}
			}
		},
		{
			"label": "HAQuDA: Build",
			"detail": "Asks for the folder and builds it only. Run HAQuDA: Install picker once first.",
			"type": "shell",
			"command": "py",
			"args": [
				"-3",
				"${workspaceFolder}\\Software\\Software_ver_2\\HAQuDA_Esp32\\scripts\\haquda-bench.py",
				"--action",
				"Build",
				"--source",
				"${input:source}"
			],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "HAQuDA: Flash",
			"detail": "Flashes the last bench build without building. The monitor, if running, steps aside.",
			"type": "shell",
			"command": "py",
			"args": [
				"-3",
				"${workspaceFolder}\\Software\\Software_ver_2\\HAQuDA_Esp32\\scripts\\haquda-bench.py",
				"--action",
				"Flash"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "HAQuDA: Change COM port",
			"detail": "Asks for the COM port and remembers it for Flash and Monitor. Run HAQuDA: Install picker once first.",
			"type": "shell",
			"command": "py",
			"args": [
				"-3",
				"${workspaceFolder}\\Software\\Software_ver_2\\HAQuDA_Esp32\\scripts\\haquda-bench.py",
				"--action",
				"Port",
				"--port",
				"${input:port}"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "HAQuDA: Install picker",
			"detail": "Installs the VS Code extension behind the folder and COM port popups. Run once, then reload the window.",
			"type": "shell",
			"command": "py",
			"args": [
				"-3",
				"${workspaceFolder}\\Software\\Software_ver_2\\HAQuDA_Esp32\\scripts\\haquda-bench.py",
				"--action",
				"InstallPicker"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "source",
			"type": "command",
			"command": "haquda.pickSource"
		},
		{
			"id": "port",
			"type": "command",
			"command": "haquda.pickPort"
		}
	]
}
